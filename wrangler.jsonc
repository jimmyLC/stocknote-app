{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stocknote-app",
  // 固定使用 Jimmy 自己的 Cloudflare 帳號。
  "account_id": "<CLOUDFLARE_ACCOUNT_ID>",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth 需要 AsyncLocalStorage
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker 只先接管 /api/*，其餘由靜態資源服務
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stocknote-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://stock.example.com"
  },
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "stock.example.com", "custom_domain": true }]
}
