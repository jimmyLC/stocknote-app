{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stocknote-app",
  // 帳號 ID 不寫在檔案裡：本機用 `wrangler login`，CI 用環境變數 CLOUDFLARE_ACCOUNT_ID。
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth 需要 AsyncLocalStorage
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker 只先接管 /api/*，其餘由靜態資源服務
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stocknote-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://stock.example.com"
  },
  "observability": { "enabled": true },
  // 每小時補一批融資維持率（證交所資料，一次 10 天，慢慢補齊一年）
  "triggers": { "crons": ["17 * * * *"] },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "stock.example.com", "custom_domain": true }]
}
