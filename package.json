{
  "name": "stocknote-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:api": "wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply stocknote-db --local",
    "db:remote": "wrangler d1 migrations apply stocknote-db --remote"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "klinecharts": "^10.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.148.0"
  }
}
